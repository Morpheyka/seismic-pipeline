# Track only citation / reproduction surface for public main
*
!.gitignore
!README.md
!RESEARCH_DIARY.md
!REPRODUCE.md
!CITATION.cff
!LICENSE
!scripts/
scripts/*
!scripts/cluster_setup.sh
!seismic_pipeline_standalone/
seismic_pipeline_standalone/*
!seismic_pipeline_standalone/requirements.txt
!seismic_pipeline_standalone/requirements-lock.txt
!seismic_pipeline_standalone/full_seismic_pipeline_example_window3.py
!seismic_pipeline_standalone/full_seismic_pipeline_example.py
!seismic_pipeline_standalone/rem_profiles_export_10days_lib.py
!seismic_pipeline_standalone/rem_profiles_export_v02_lib.py
!seismic_pipeline_standalone/scripts/
!seismic_pipeline_standalone/scripts/**
!seismic_pipeline_standalone/seismic_pipeline/
!seismic_pipeline_standalone/seismic_pipeline/**
!seismic_pipeline_standalone/artifacts/
!seismic_pipeline_standalone/artifacts/**
seismic_pipeline_standalone/scripts/**/__pycache__/
seismic_pipeline_standalone/seismic_pipeline/**/__pycache__/
seismic_pipeline_standalone/seismic_pipeline/**/*.pyc

# Standard excludes under tracked paths
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
*.log
*.pkl
*.ipynb_checkpoints/
*.egg-info/
run_output*/
run_output_*/
.DS_Store
**/.~lock.*

# Keep conference frozen CSVs + Level A figure scripts/data/SVGs
# (global deny for other generated dumps still applies via leading *)
